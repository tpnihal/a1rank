# Copy to .env.local for local development. On Vercel/Hostinger add these in the dashboard.
# Never commit real keys.

# Email for enquiries, newsletter sign-ups and "someone ran an audit" lead emails.
# Without SMTP_PASS (or the Resend pair below) enquiries show an error and audit leads are not emailed.
#
# Option 1 (used on a1rank.com): send through the A1 Rank mailbox on Hostinger.
# Only the mailbox password is required. Type it in the hosting dashboard, never in code or chat.
SMTP_PASS=
# Optional overrides. Defaults: smtp.hostinger.com, 465 (SSL), admin@a1rank.com
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=admin@a1rank.com
#
# Option 2 (fallback): Resend. Used when SMTP_PASS is not set, or if SMTP fails.
RESEND_API_KEY=
# Where enquiries are delivered
ENQUIRY_TO=admin@a1rank.com
# Sender. Optional with SMTP (defaults to "A1 Rank Website <SMTP_USER>" and must be that mailbox or its alias).
# Required with Resend: an address on a domain verified in Resend.
ENQUIRY_FROM=

# Free Website Audit tool
# Google PageSpeed Insights API key (required for the audit). Create one in Google Cloud Console:
# enable "PageSpeed Insights API", then Credentials > Create API key, and restrict it to that API.
PAGESPEED_API_KEY=
# Optional. Adds a short plain-English summary to each audit report, written by Claude.
ANTHROPIC_API_KEY=

# Audit leads (email, WhatsApp, website, scores) are saved to a Google Sheet through this address:
# the web app URL of the Apps Script in docs/audit-leads-google-sheet.md. Treat it as a secret.
LEAD_WEBHOOK_URL=
