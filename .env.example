# Copy to .env.local for local development. On Vercel/Hostinger add these in the dashboard.
# Never commit real keys.

# Resend (enquiry + newsletter emails). Without it the forms show a "email us directly" message.
RESEND_API_KEY=
# Where enquiries are delivered
ENQUIRY_TO=admin@a1rank.com
# Must be an address on a domain verified in Resend, e.g. "A1 Rank Website <website@a1rank.com>"
ENQUIRY_FROM=

# Free Website Audit tool
# Google PageSpeed Insights API key (required for the audit). Create one in Google Cloud Console:
# enable "PageSpeed Insights API", then Credentials > Create API key, and restrict it to that API.
PAGESPEED_API_KEY=
# Optional. Adds a short plain-English summary to each audit report, written by Claude.
ANTHROPIC_API_KEY=
